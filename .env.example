# Safe default: ONLY local demo. Never commit tokens or add them to the UI.
DATABASE_PATH=./outreach.db
AI_PROVIDER=template
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
X_ENABLE_READ=false
X_ENABLE_LIVE_SEND=false
# Requires an X OAuth 2.0 PKCE USER token with dm.write, dm.read,
# tweet.read and users.read scopes, AND platform credit/access.
X_USER_ACCESS_TOKEN=
# Strict allowlist of numeric X user IDs for accounts YOU CONTROL/consenting testers.
X_TEST_ALLOWLIST_IDS=
